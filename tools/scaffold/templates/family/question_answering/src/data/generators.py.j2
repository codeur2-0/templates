{#- Générateur du corpus de fiches produit et des questions de support (famille QA). -#}
"""Synthetic corpus generator of the question answering family.

{{ wrap(spec.data.description, 98) }}

The generator plants **canonical sentences** in the corpus — one per (product, article) pair —
and writes the questions from those sentences. The QA contract is different from the RAG one, and
the data says so:

* the reference answer of an answerable question is the **exact sentence** of the fiche, so
  ``answer_exact_match`` is reachable and measures something: a system that paraphrases the
  sentence loses points even when it is right;
* the questions carry the product name (the discriminating entity), so a *paraphrase* question is
  harder to *answer* while staying answerable at all — a paraphrase that dropped the entity would
  not be a hard question, it would be an ambiguous one;
* multi-document questions ask two things at once (a return window and its cost, a warranty and a
  repair delay): the reference answer concatenates the two sentences and a system that returns a
  single passage is structurally capped on that segment;
* a share of the questions is **absent** from the corpus (``hors_corpus``): the only correct
  behaviour is to abstain, and the schema refuses to let such a question carry a fake gold span.

Everything is seeded: two calls with the same configuration produce byte-identical frames.
"""

from __future__ import annotations

from collections.abc import Mapping, Sequence
from dataclasses import dataclass, field
from datetime import date, timedelta
from typing import Any

import numpy as np
import pandas as pd

from src.data.generator_base import BaseCorpusGenerator, GeneratedCorpus
from src.preprocessing.transformers import tokenize
from src.utils.config_access import as_mapping
from src.utils.logging import get_logger

logger = get_logger(__name__)


@dataclass(frozen=True, slots=True)
class Product:
    """A product of the catalogue, with the values its fiches quote.

    Attributes:
        code: Four-letter product code (identifies the SAV folder).
        name: Name used inside the sentences and the questions.
        gender: Grammatical gender (``m`` or ``f``), used to agree the articles.
        category: Product family (audio, maison, informatique, mobilite).
        price: Catalogue price in euros (the return fee is a share of it).
        warranty_months: Warranty duration, in months.
        return_days: Return window, in days.
        sav_hours: Service level of the repair desk, in working hours.
        update_months: Firmware release cadence, in months.
        compat: Compatibility note quoted by the compatibility fiche.
    """

    code: str
    name: str
    gender: str
    category: str
    price: float
    warranty_months: int
    return_days: int
    sav_hours: int
    update_months: int
    compat: str

    @property
    def article(self) -> str:
        """Definite article that agrees with the name (``le``, ``la`` or ``l'``)."""
        if self.name[:1].lower() in "aeiouéèêàâîïôû":
            return "l'"
        return "le" if self.gender == "m" else "la"

    @property
    def of_the(self) -> str:
        """Contraction of ``de`` with the article (``du``, ``de la``, ``de l'``)."""
        return {"le": "du", "la": "de la", "l'": "de l'"}[self.article]

    @property
    def to_the(self) -> str:
        """Contraction of ``à`` with the article (``au``, ``à la``, ``à l'``)."""
        return {"le": "au", "la": "à la", "l'": "à l'"}[self.article]

    @property
    def with_article(self) -> str:
        """Name preceded by its article (``la souris Sour``, ``l'enceinte Onda``)."""
        separator = "" if self.article.endswith("'") else " "
        return f"{self.article}{separator}{self.name}"

    @property
    def of_name(self) -> str:
        """Name preceded by the contraction of ``de`` (``du casque Aria``, ``de l'enceinte``)."""
        return f"{self.of_the}{self.with_article.removeprefix(self.article)}"

    @property
    def to_name(self) -> str:
        """Name preceded by the contraction of ``à`` (``au casque Aria``, ``à l'enceinte``)."""
        return f"{self.to_the}{self.with_article.removeprefix(self.article)}"

    @property
    def titled(self) -> str:
        """Name preceded by its article, sentence-initial (``La souris Sour``, ``L'enceinte``)."""
        return self.with_article[:1].upper() + self.with_article[1:]


@dataclass(frozen=True, slots=True)
class ArticleKind:
    """One kind of fiche (warranty, returns, fees, repair desk, compatibility, firmware).

    Attributes:
        key: Stable identifier of the kind.
        label: Lower-case label, used in prose.
        title_label: Title-case label, used in the title of the fiche.
        section: Editorial section declared in the contract.
        source: Wiki space the fiche belongs to.
        intent: Business intent of the questions written about this fiche.
        statement: Canonical sentence of the fiche; ``{value}`` holds the quoted value.
        question: Factual question whose answer is the canonical sentence.
        paraphrasis: Alternative wording of that question. The product name is kept - it is what
            makes the question answerable by a *single* fiche - and the vocabulary is deliberately
            moved away from the fiche, which is what makes the paraphrase hard.
        conditions: Generic sentence recalling the scope of the fiche.
    """

    key: str
    label: str
    title_label: str
    section: str
    source: str
    intent: str
    statement: str
    question: str
    paraphrasis: str
    conditions: str


