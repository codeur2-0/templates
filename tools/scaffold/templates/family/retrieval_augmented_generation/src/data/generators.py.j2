@dataclass(frozen=True, slots=True)
class Population:
    """Scope of a document edition: the population the rule applies to.

    Attributes:
        label: Short label used in the report and in the answers.
        question_phrase: The scope, phrased identically in the corpus and in the question —
            « pour les cadres au forfait ». Writing it the same way on both sides is what makes
            the annotated span discriminating instead of merely plausible.
    """

    label: str
    question_phrase: str


