@dataclass
class SyntheticCorpusGenerator(BaseCorpusGenerator):
    """Generate the synthetic knowledge base and its annotated questions.

    Attributes:
        dataset_name: Name of the generated dataset.
        n_documents: Target number of documents.
        seed: Seed of every random draw.
        reference_date: Date used as "today" for the publication dates.
        paraphrase_share: Share of questions written as paraphrases.
        multi_document_share: Share of questions requiring two documents.
        hors_corpus_share: Share of questions the corpus cannot answer.
        documents_per_topic: Documents generated per topic (they reuse the same facts with
            different values, which is what creates the near-duplicate competition).
        val_size: Share of questions in the validation split.
        test_size: Share of questions in the test split.
    """

    dataset_name: str = "{{ spec.data.dataset_name }}"
    n_documents: int = {{ spec.data.n_samples }}
    seed: int = {{ spec.data.seed }}
    reference_date: date = date(2025, 1, 6)
    paraphrase_share: float = 0.30
    multi_document_share: float = 0.15
    hors_corpus_share: float = 0.10
    documents_per_topic: int = 24
    val_size: float = 0.20
    test_size: float = 0.35
    facts: tuple[FactTemplate, ...] = field(default=FACTS, repr=False)
    random_state: np.random.Generator = field(init=False, repr=False)

    def __post_init__(self) -> None:
        """Seed the random generator and validate the shares."""
        self.random_state = np.random.default_rng(self.seed)
        total = self.paraphrase_share + self.multi_document_share + self.hors_corpus_share
        if total >= 1.0:
            msg = (
                "paraphrase_share + multi_document_share + hors_corpus_share must stay below 1, "
                f"got {total:.2f}"
            )
            raise ValueError(msg)

    @classmethod
    def from_config(cls, config: Any, *, seed: int | None = None) -> SyntheticCorpusGenerator:
        """Build the generator from the ``data`` node of the configuration.

        Args:
            config: ``data`` configuration node (``seed``, ``n_samples`` and the
                ``corpus`` sub-node are read).
            seed: Optional seed override.

        Returns:
            The configured generator.
        """
        settings = as_mapping(config)
        corpus = as_mapping(settings.get("corpus"))
        return cls(
            dataset_name=str(settings.get("dataset_name", "internal_knowledge_base")),
            n_documents=int(settings.get("n_samples", 360)),
            seed=int(seed if seed is not None else settings.get("seed", 42)),
            reference_date=_parse_date(corpus.get("reference_date")) or date(2025, 1, 6),
            paraphrase_share=float(corpus.get("paraphrase_share", 0.30)),
            multi_document_share=float(corpus.get("multi_document_share", 0.15)),
            hors_corpus_share=float(corpus.get("hors_corpus_share", 0.10)),
            documents_per_topic=int(corpus.get("documents_per_topic", 24)),
            val_size=float(corpus.get("val_size", 0.20)),
            test_size=float(corpus.get("test_size", 0.35)),
        )

    # ------------------------------------------------------------------ génération --------
    def generate(self) -> GeneratedCorpus:
        """Generate the corpus, the questions and the metadata.

        Returns:
            The :class:`GeneratedCorpus`.
        """
        documents = self._documents()
        questions = self._questions(documents)
        metadata = self._metadata(documents, questions)
        logger.info(
            "Corpus '{}' generated | {} documents | {} questions | {} unanswerable",
            self.dataset_name,
            len(documents),
            len(questions),
            int((questions["answer_type"] == "unanswerable").sum()),
        )
        return GeneratedCorpus(documents=documents, queries=questions, metadata=metadata)

    def _documents(self) -> pd.DataFrame:
        """Build the corpus, one row per document.

        Each document is an *edition*: it carries all the facts of its topic, filled with the
        values of **its scope** (a population), plus generic filler sentences. Republishing the
        same procedure for another population is exactly what happens in a real wiki — and it is
        what makes the retrieval question well posed, since the scope is the discriminator that
        tells two editions apart.

        Returns:
            The corpus frame, validated by :class:`src.data.schemas.DocumentsSchema`.
        """
        rows: list[dict[str, Any]] = []
        for topic in sorted({fact.topic for fact in self.facts}):
            topic_facts = [fact for fact in self.facts if fact.topic == topic]
            for index, population in enumerate(self._editions()):
                block = self._fact_block(topic_facts, population)
                rows.append(self._document_row(topic, population, block, index))
        frame = pd.DataFrame(rows)
        return frame.sort_values("doc_id", kind="stable").reset_index(drop=True)

    def _editions(self) -> list[Population]:
        """Return the scope of each document of a topic.

        The corpus is a cross product: every topic is declined for every population, and each of
        those editions is republished ``editions_per_population`` times (same rules, other date).
        That structure is what makes a question answerable *and* discriminating: the scope narrows
        the corpus to one edition, the duplicate editions are annotated together as relevant.
        """
        return [population for _ in range(self.editions_per_population) for population in POPULATIONS]

    @property
    def editions_per_population(self) -> int:
        """Number of republications of each (topic, population) edition.

        Derived from ``n_documents`` — the contract asserted by the tests and quoted in the README
        — so that the declared dataset size and the generated one cannot drift apart.
        """
        n_topics = len({fact.topic for fact in self.facts})
        per_edition = max(n_topics * len(POPULATIONS), 1)
        return max(round(self.n_documents / per_edition), 1)

    @staticmethod
    def _fact_block(
        topic_facts: Sequence[FactTemplate], population: Population
    ) -> list[tuple[FactTemplate, str]]:
        """Bind every fact of a topic to the value of one scope.

        The value depends on the scope and not on the edition, so the documents that share a scope
        are genuine duplicates (same rules, same values, other date). They are annotated together
        as relevant, which is the honest judgement: no user distinguishes two identical pages.

        Args:
            topic_facts: Facts of the topic.
            population: Scope of the document.

        Returns:
            The (fact, value) pairs of the document.
        """
        index = POPULATIONS.index(population)
        return [(fact, fact.values[index % len(fact.values)]) for fact in topic_facts]

    def _title(self, topic: str, index: int) -> str:
        """Return a document title (alternating templates, plus a version marker)."""
        candidates = TITLE_TEMPLATES.get(topic, (f"Note interne {topic}",))
        return f"{candidates[index % len(candidates)]} — édition {index + 1}"

    def _document_row(
        self,
        topic: str,
        population: Population,
        block: Sequence[tuple[FactTemplate, str]],
        index: int,
    ) -> dict[str, Any]:
        """Build one document row: the scoped rules and the filler sentences.

        The scope is glued to the rule (« …, pour les cadres au forfait. ») rather than written in a
        separate sentence. It is what makes the annotated span *discriminating*: the same rule
        appears in every edition of the topic, so a span that does not carry its scope would be
        relevant for eight documents at once and the evaluation would measure a coin flip.
        """
        sentences: list[str] = []
        for fact, value in block:
            statement = fact.statement.format(value=value).rstrip(".")
            sentences.append(f"{statement}, {population.question_phrase}.")
        for _ in range(4):
            sentences.append(str(self.random_state.choice(FILLERS)))
        text = " ".join(sentences)
        published = self.reference_date - timedelta(days=int(self.random_state.integers(30, 900)))
        return {
            "doc_id": f"DOC-{self._next_document_number(topic, index):04d}",
            "title": self._title(topic, index),
            "section": block[0][0].section,
            "source": block[0][0].source,
            "published_at": pd.Timestamp(published),
            "n_tokens": len(tokenize(text)),
            "text": text,
        }

    def _next_document_number(self, topic: str, index: int) -> int:
        """Return a stable, unique document number."""
        topics = sorted({fact.topic for fact in self.facts})
        return topics.index(topic) * 100 + index + 1

    def _questions(self, documents: pd.DataFrame) -> pd.DataFrame:
        """Build the annotated questions from the planted facts.

        Args:
            documents: Generated corpus.

        Returns:
            The question frame, validated by :class:`src.data.schemas.QueriesSchema`.
        """
        rows: list[dict[str, Any]] = []
        for record in documents.itertuples(index=False):
            population = self._population_in(str(record.text))
            for fact, statement in self._facts_in(str(record.text)):
                rows.append(
                    self._question_row(str(record.doc_id), fact, statement, population)
                )
                if fact.paraphrasable:
                    rows.append(
                        self._question_row(
                            str(record.doc_id), fact, statement, population, paraphrase=True
                        )
                    )
        questions = self._merge_twins(pd.DataFrame(rows))
        questions = self._append_multi_document(questions, documents)
        questions = self._append_hors_corpus(questions, documents)
        questions = self._assign_splits(questions)
        questions = questions.sort_values("query_id", kind="stable").reset_index(drop=True)
        return questions

    def _merge_twins(self, questions: pd.DataFrame) -> pd.DataFrame:
        """Merge the questions whose answer appears in several twin documents.

        The same fact is planted in several editions of a document. Two questions that share their
        wording *and* their reference answer are the same question, annotated with several relevant
        documents: leaving them as separate rows would punish a retriever that returns the right
        rule from the « wrong » edition — a distinction no user would ever make. The merged row
        carries every relevant document identifier, which is also what makes recall@k meaningful
        on a duplicated corpus.

        Args:
            questions: Raw question rows.

        Returns:
            The deduplicated frame, one row per distinct question.
        """
        if questions.empty:
            return questions
        grouped = (
            questions.groupby(["question", "reference_answer"], sort=True, as_index=False)
            .agg(
                {
                    "answer_type": "first",
                    "difficulty": "first",
                    "intent": "first",
                    "split": "first",
                    "gold_doc_ids": lambda values: ",".join(sorted({item for value in values for item in str(value).split(",") if item})),
                    "gold_span": "first",
                    "n_gold_docs": lambda values: int(sum(int(value) for value in values)),
                }
            )
            .reset_index(drop=True)
        )
        grouped["query_id"] = ""
        grouped["split"] = ""
        return grouped

    def _facts_in(self, text: str) -> list[tuple[FactTemplate, str]]:
        """Return the (fact, sentence) pairs actually planted in a document.

        The match is done on the *stable prefix* of the statement (everything before the value):
        it is what identifies the fact, independently of the value it was filled with.

        Args:
            text: Document text.

        Returns:
            The facts found, in reading order of their sentence.
        """
        found: list[tuple[FactTemplate, str]] = []
        sentences = [sentence.strip() for sentence in text.split(".") if sentence.strip()]
        for fact in self.facts:
            marker = fact.statement.split("{value}")[0].strip()
            if not marker:
                continue
            for sentence in sentences:
                if marker in sentence and all(sentence != existing for _, existing in found):
                    found.append((fact, sentence))
                    break
        return found

    def _question_row(
        self,
        doc_id: str,
        fact: FactTemplate,
        statement: str,
        population: Population,
        *,
        paraphrase: bool = False,
    ) -> dict[str, Any]:
        """Build one annotated question for one scoped rule.

        The question carries the scope — « … pour les cadres au forfait ? » — because it is what
        makes it answerable by a single rule. A question without its scope would be answered by
        eight editions equally well, and the evaluation would measure a coin flip.

        Args:
            doc_id: Identifier of the document that hosts the rule.
            fact: Fact the question is about.
            statement: Sentence of the corpus that contains the answer.
            population: Scope of the document.
            paraphrase: Whether to write a paraphrase question instead of the factual one.

        Returns:
            The annotated question row.
        """
        span = statement.strip()
        if not span.endswith("."):
            span += "."
        value = self._value_of(span, fact)
        question = (
            self._paraphrase_question(fact, population)
            if paraphrase
            else f"{fact.question.rstrip(' ?')} {population.question_phrase} ?"
        )
        return {
            "query_id": "",
            "question": question,
            "reference_answer": f"{fact.answer.format(value=value)} ({population.question_phrase})",
            "answer_type": "abstractive" if paraphrase else "extractive",
            "difficulty": "paraphrase" if paraphrase else "facile",
            "intent": self._intent(fact.section),
            "split": "",
            "gold_doc_ids": doc_id,
            "gold_span": span,
            "n_gold_docs": 1,
        }

    @staticmethod
    def _population_in(text: str) -> Population:
        """Identify the scope of a document from its text.

        The document writes its scope with the same phrase as the question (« …, pour les cadres
        au forfait. »): the scope is the discriminator of the edition, so reading it back from the
        text is both the simplest and the most honest way to annotate the question.

        Args:
            text: Document text.

        Returns:
            The matching population; the first one when no scope phrase is found (defensive).
        """
        for population in POPULATIONS:
            if population.question_phrase in text:
                return population
        return POPULATIONS[0]

    @staticmethod
    def _paraphrase_question(fact: FactTemplate, population: Population) -> str:
        """Return a paraphrase question sharing almost no content word with the statement.

        The scope is preserved: without it, the question would target eight editions at once, and
        the « paraphrase » segment would measure ambiguity instead of paraphrase.
        """
        if fact.paraphrase:
            marker = fact.paraphrase.split("{value}")[0].strip()
            return f"Que prévoit la règle suivante : « {marker} … » {population.question_phrase} ?"
        return f"Que dit la règle sur {fact.label} {population.question_phrase} ?"

    @staticmethod
    def _value_of(statement: str, fact: FactTemplate) -> str:
        """Extract the value that fills a statement.

        The sentence carries its scope after the rule (« …, pour les cadres au forfait. »), so the
        value stops at the first delimiter met after the prefix — the statement suffix, the comma
        of the scope or the final period, whichever comes first. Reading up to the last period
        would return the scope as part of the value.
        """
        prefix, _, suffix = fact.statement.partition("{value}")
        start = statement.find(prefix)
        if start < 0:
            return "n/a"
        start += len(prefix)
        # Le suffixe du gabarit se termine par un point ou une virgule que la phrase scopée
        # déplace : on cherche son cœur («  heures »), pas sa ponctuation.
        suffix_core = suffix.strip().rstrip(".,;")
        candidates = [
            position
            for position in (
                statement.find(suffix_core, start) if suffix_core else -1,
                statement.find(",", start),
                statement.find(".", start),
            )
            if position >= 0
        ]
        end = min(candidates) if candidates else len(statement)
        return statement[start:end].strip()

    @staticmethod
    def _intent(section: str) -> str:
        """Map an editorial section onto a question intent."""
        return {
            "politique": "politique",
            "procedure": "procedure",
            "definition": "definition",
            "contact": "contact",
            "calcul": "calcul",
            "conformite": "politique",
        }.get(section, "procedure")

    def _append_multi_document(
        self, questions: pd.DataFrame, documents: pd.DataFrame
    ) -> pd.DataFrame:
        """Add questions whose answer requires exactly two documents.

        They are built by pairing two questions of the same intent: the reference answer
        concatenates both facts and both documents are annotated relevant. Any system that
        returns a single passage is structurally capped on these questions, which is exactly the
        point of the segment.
        """
        if questions.empty:
            return questions
        # Les questions composées sont bâties sur les formulations courtes (« facile ») : une
        # question multi-document est la concaténation de deux questions, et le contrat de données
        # plafonne la longueur d'une question à 240 caractères.
        pool = questions.loc[questions["difficulty"] == "facile"].reset_index(drop=True)
        if len(pool) < 4:
            pool = questions.reset_index(drop=True)
        count = max(int(len(questions) * self.multi_document_share), 1)
        count = min(count, max(len(pool) // 2, 1))
        first = pool.iloc[::2].head(count).reset_index(drop=True)
        second = pool.iloc[1::2].head(count).reset_index(drop=True)
        rows: list[dict[str, Any]] = []
        for left, right in zip(first.to_dict(orient="records"), second.to_dict(orient="records"), strict=False):
            if left["gold_doc_ids"] == right["gold_doc_ids"]:
                continue
            rows.append(
                {
                    "query_id": "",
                    "question": _combine_questions(
                        str(left["question"]), str(right["question"])
                    ),
                    "reference_answer": f"{left['reference_answer']} {right['reference_answer']}",
                    "answer_type": "abstractive",
                    "difficulty": "multi_document",
                    "intent": left["intent"],
                    "split": "",
                    "gold_doc_ids": f"{left['gold_doc_ids']},{right['gold_doc_ids']}",
                    "gold_span": _merge_spans(left["gold_span"], right["gold_span"]),
                    "n_gold_docs": 2,
                }
            )
        if not rows:
            return questions
        return pd.concat([questions, pd.DataFrame(rows)], ignore_index=True)

    def _append_hors_corpus(
        self, questions: pd.DataFrame, documents: pd.DataFrame
    ) -> pd.DataFrame:
        """Add questions that the corpus cannot answer.

        The ``gold_doc_ids`` column points at the *nearest* document — the one a lexical
        retriever will return — while ``gold_span`` stays empty and ``answer_type`` is
        ``unanswerable``. The evaluator treats those questions separately: the only correct
        behaviour is to abstain, and answering them is counted as a hallucination.
        """
        count = max(int(len(questions) * self.hors_corpus_share), 1)
        rows: list[dict[str, Any]] = []
        # Les questions hors corpus sont construites par combinaison d'un fait réel et d'une
        # population absente du corpus (« les alternants », « la filiale espagnole »…) : la
        # question paraît anodine, le vocabulaire est celui du corpus, et pourtant aucun document
        # n'y répond. C'est le seul moyen d'obtenir un volume suffisant d'exemples d'abstention,
        # là où une liste écrite à la main plafonnerait à quelques unités.
        combinations = [
            (fact, entity)
            for fact in self.facts
            for entity in HORS_CORPUS_ENTITIES
        ]
        indices = self.random_state.permutation(len(combinations))[:count]
        topic_document = {
            fact.topic: str(
                documents.loc[
                    documents["title"].str.contains(TITLE_TEMPLATES[fact.topic][0].split(" :")[0], regex=False)
                ].iloc[0]["doc_id"]
            )
            if not documents.loc[
                documents["title"].str.contains(TITLE_TEMPLATES[fact.topic][0].split(" :")[0], regex=False)
            ].empty
            else str(documents.iloc[0]["doc_id"])
            for fact in self.facts
        }
        for position in indices:
            fact, entity = combinations[int(position)]
            rows.append(
                {
                    "query_id": "",
                    "question": f"Quel est {fact.label} pour {entity} ?",
                    "reference_answer": "Aucune réponse dans le corpus.",
                    "answer_type": "unanswerable",
                    "difficulty": "hors_corpus",
                    "intent": self._intent(fact.section),
                    "split": "",
                    "gold_doc_ids": topic_document.get(fact.topic, str(documents.iloc[0]["doc_id"])),
                    "gold_span": "",
                    "n_gold_docs": 1,
                }
            )
        for index, question in enumerate(HORS_CORPUS_QUESTIONS[: max(count // 4, 1)]):
            rows.append(
                {
                    "query_id": "",
                    "question": question,
                    "reference_answer": "Aucune réponse dans le corpus.",
                    "answer_type": "unanswerable",
                    "difficulty": "hors_corpus",
                    "intent": "politique",
                    "split": "",
                    "gold_doc_ids": str(documents.iloc[index % len(documents)]["doc_id"]),
                    "gold_span": "",
                    "n_gold_docs": 1,
                }
            )
        if not rows:
            return questions
        return pd.concat([questions, pd.DataFrame(rows)], ignore_index=True)

    def _assign_splits(self, questions: pd.DataFrame) -> pd.DataFrame:
        """Assign an identifier and a split to every question.

        The split is drawn per question with the configured proportions, but the *unanswerable*
        questions are stratified on purpose: each split must contain some, otherwise the
        abstention metric would be measured on the test split only.
        """
        frame = questions.reset_index(drop=True).copy()
        draws = self.random_state.random(len(frame))
        splits = np.where(
            draws < self.test_size,
            "test",
            np.where(draws < self.test_size + self.val_size, "val", "calibration"),
        )
        frame["split"] = splits
        frame["query_id"] = [f"QRY-{index + 1:04d}" for index in range(len(frame))]
        return frame

    def _metadata(self, documents: pd.DataFrame, questions: pd.DataFrame) -> dict[str, Any]:
        """Build the generation metadata archived next to the corpus."""
        by_difficulty = questions["difficulty"].value_counts().to_dict()
        answerable = questions.loc[questions["answer_type"] != "unanswerable"]
        return {
            "dataset_name": self.dataset_name,
            "seed": self.seed,
            "reference_date": self.reference_date.isoformat(),
            "n_documents": int(len(documents)),
            "n_questions": int(len(questions)),
            "n_answerable": int(len(answerable)),
            "n_unanswerable": int(len(questions) - len(answerable)),
            "n_sources": int(documents["source"].nunique()),
            "mean_document_tokens": float(documents["n_tokens"].mean()),
            "questions_by_difficulty": {str(key): int(value) for key, value in by_difficulty.items()},
            "questions_by_split": {
                str(key): int(value) for key, value in questions["split"].value_counts().to_dict().items()
            },
            "retrievable_ceiling": round(
                float(len(answerable) / max(len(questions), 1)) * 100.0, 2
            ),
            "generator": "SyntheticCorpusGenerator",
            "notes": [
                "Les questions multi-document exigent deux documents : tout système qui s'arrête "
                "au premier passage est plafonné sur ce segment.",
                "Les questions hors corpus annotent le document le plus proche sans extrait "
                "répondant : seule l'abstention y est correcte.",
                "Les documents paraphrases ne partagent presque aucun mot de contenu avec leur "
                "source : c'est là qu'un retriever purement lexical décroche.",
            ],
        }


def _combine_questions(left: str, right: str, *, limit: int = 232) -> str:
    """Combine two questions into one multi-document question.

    Args:
        left: First question.
        right: Second question.
        limit: Maximum length (the data contract caps a question at 240 characters).

    Returns:
        The combined question, truncated on word boundaries when both do not fit.
    """
    left_clean = str(left).strip().rstrip(" ?")
    right_clean = str(right).strip().rstrip(" ?")
    combined = f"{left_clean}, et {right_clean} ?"
    if len(combined) <= limit:
        return combined
    budget = max((limit - 8) // 2, 40)
    return f"{left_clean[:budget].rstrip()} … et {right_clean[:budget].rstrip()} ?"


def _merge_spans(*spans: str) -> str:
    """Join several annotated extracts with the multi-span separator.

    A question answered by two documents has two answering passages; the contract keeps them in
    one column, separated by ``||``, so that a retrieved passage counts as relevant when it covers
    *any* of them. An empty span means "no extract", which is reserved for the unanswerable
    questions and verified by the schema.
    """
    cleaned = [str(span).strip() for span in spans if str(span).strip()]
    return " || ".join(cleaned)


def _parse_date(value: Any) -> date | None:
    """Parse a configuration date (``YYYY-MM-DD`` or ``None``)."""
    if value in (None, ""):
        return None
    if isinstance(value, date):
        return value
    return date.fromisoformat(str(value))


