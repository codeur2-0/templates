@dataclass(frozen=True, slots=True)
class FactTemplate:
    """A planted fact: the sentence that answers, and how to ask a question about it.

    Attributes:
        topic: Business topic of the fact.
        section: Editorial section of the document that will host the fact.
        source: Wiki space of the document.
        statement: Sentence inserted in the corpus; ``{value}`` is replaced by a value.
        question: Question template; ``{label}`` is replaced by the fact label.
        label: Human label of the fact, used inside the question.
        answer: Reference answer, ``{value}`` replaced by the value.
        values: Admissible values (one document per value).
        paraphrasable: Whether a "paraphrase" question can be written for this fact (a question
            that shares almost no content word with the statement).
        paraphrase: Alternative wording of the statement, used to write the paraphrase question.
    """

    topic: str
    section: str
    source: str
    statement: str
    question: str
    label: str
    answer: str
    values: tuple[str, ...]
    paraphrasable: bool = True
    paraphrase: str = ""


