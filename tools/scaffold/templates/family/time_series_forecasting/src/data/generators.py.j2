logger = get_logger(__name__)

#: Default dataset name (overridable through the constructor / Hydra config).
DEFAULT_DATASET_NAME = "{{ spec.data.dataset_name }}"

#: Default forecast horizons, in days. All are <= 7 so that the seasonal-naive anchor stays legal.
DEFAULT_HORIZONS: tuple[int, ...] = (1, 2, 3, 7)

#: Columns whose value belongs to the future: ground truth for evaluation, never features.
DIAGNOSTIC_COLUMNS: tuple[str, ...] = (
    "load_mw",
    "target_date",
    "target_month",
    "event_type",
    "is_extreme_event",
)

#: French weekday abbreviations used for the one-hot encoded target calendar.
WEEKDAY_LABELS: tuple[str, ...] = ("mon", "tue", "wed", "thu", "fri", "sat", "sun")

#: Month abbreviations kept as metadata for the seasonal error breakdown.
MONTH_LABELS: tuple[str, ...] = (
    "jan",
    "feb",
    "mar",
    "apr",
    "may",
    "jun",
    "jul",
    "aug",
    "sep",
    "oct",
    "nov",
    "dec",
)

#: Weekly profile of the regional load (Monday = 0): residential trough, industrial weekday peak.
WEEKDAY_FACTORS: tuple[float, ...] = (1.060, 1.040, 1.030, 1.020, 0.990, 0.845, 0.800)

#: Fixed-date metropolitan public holidays (month, day). Easter-based ones are computed.
FIXED_HOLIDAYS: tuple[tuple[int, int], ...] = (
    (1, 1),
    (5, 1),
    (5, 8),
    (7, 14),
    (8, 15),
    (11, 1),
    (11, 11),
    (12, 25),
)

#: Approximate French school holiday windows (month, start day, month, end day), zone-agnostic.
SCHOOL_HOLIDAY_WINDOWS: tuple[tuple[int, int, int, int], ...] = (
    (2, 8, 2, 24),
    (4, 6, 4, 22),
    (7, 6, 8, 31),
    (10, 19, 11, 4),
    (12, 20, 12, 31),
    (1, 1, 1, 4),
)

#: Climatological normals of the simulated region: mean annual temperature and amplitude.
TEMPERATURE_MEAN_C = 12.4
TEMPERATURE_AMPLITUDE_C = 9.6

#: Temperature shift (°C) applied during a regime episode, before the three-day smoothing.
COLD_SNAP_SHIFT_C = -7.5
HEATWAVE_SHIFT_C = 6.0

#: Heating and cooling thresholds of the thermo-sensitivity model (°C).
HEATING_THRESHOLD_C = 15.0
COOLING_THRESHOLD_C = 24.0

#: Degree-day reference temperatures exposed as features (industry convention).
HDD_BASE_C = 18.0
CDD_BASE_C = 24.0


class SyntheticDataGenerator:
    """Deterministic generator of the {{ spec.data.dataset_name | replace("_", " ") }} dataset.

    Example:
        >>> generator = SyntheticDataGenerator(n_samples=40, seed=42, horizons=(1, 7))
        >>> frame = generator.generate()
        >>> frame.shape[0]
        40
        >>> {"load_mw", "horizon_days", "origin_date"} <= set(frame.columns)
        True
        >>> bool(frame["origin_date"].is_monotonic_increasing)
        True
    """

    #: Options accepted from ``conf/data/default.yaml`` (extra keys of the data node).
    SUPPORTED_OPTIONS: ClassVar[tuple[str, ...]] = (
        "horizons",
        "start_date",
        "warmup_days",
        "base_load_mw",
        "annual_amplitude",
        "trend_per_year",
        "heat_gradient",
        "cool_gradient",
        "holiday_drop",
        "school_holiday_lift",
        "noise_sigma",
        "noise_ar",
        "forecast_error_j1",
        "forecast_error_growth",
        "missing_temperature_rate",
        "cold_snap_days",
        "heatwave_days",
        "shutdown_days",
    )

    #: Columns produced, in the order they appear in the frame (``RawDataSchema`` is strict).
    COLUMNS: ClassVar[tuple[str, ...]] = (
        "sample_id",
        "origin_date",
        "horizon_days",
        "target_date",
        "target_month",
        "event_type",
        "is_extreme_event",
        "load_mw",
        "load_last_observed",
        "load_lag_1d",
        "load_lag_2d",
        "load_lag_7d",
        "load_lag_14d",
        "load_lag_28d",
        "load_rolling_mean_7d",
        "load_rolling_std_7d",
        "load_rolling_min_7d",
        "load_rolling_mean_28d",
        "load_seasonal_naive",
        "temperature_forecast_c",
        "temperature_forecast_prev_c",
        "temperature_anomaly_c",
        "temperature_lag_1d",
        "temperature_rolling_mean_7d",
        "hdd_target",
        "cdd_target",
        "target_weekday",
