    # ------------------------------------------------------------------ helpers ---------
    def _horizon_mape(self, result: EvaluationResult, horizon: int) -> float:
        """Return the MAPE of a given horizon, or NaN.

        Args:
            result: Evaluation result.
            horizon: Horizon in days.

        Returns:
            The MAPE in percent.
        """
        table = result.per_horizon
        if table.empty or "horizon" not in table.columns:
            return float("nan")
        match = table[table["horizon"].astype(int) == int(horizon)]
        return _float(match["mape_pct"].iloc[0]) if not match.empty else float("nan")

    def _config_artifact(self, key: str, default: str) -> str:
        """Read an artefact file name from the configuration.

        Args:
            key: Key inside the ``train.artifacts`` node.
            default: Value used when the key is absent.

        Returns:
            The resolved file name.
        """
        artifacts = (self.config.get("train") or {}).get("artifacts") or {}
        return str(artifacts.get(key) or default)


#: Seuils dont l'unité ne peut pas prêter à confusion. Leur valeur documentée par défaut est ≥
#10,
#: donc une déclaration comprise entre 0 et 1 est nécessairement une fraction (0.85 pour 85 %)
#et
#: peut être convertie sans deviner. Les autres seuils exprimés en pourcentage (``bias_max``,
#: ``mape_max``, ``backtest_spread_max``) peuvent légitimement valoir moins de 1 : ils ne sont
#: jamais réinterprétés, et la chaîne ``target`` du verdict affiche l'unité pour rendre une
#erreur
#: de saisie visible à la lecture.
PERCENT_FRACTION_KEYS: frozenset[str] = frozenset(
    {"interval_coverage_min", "improvement_vs_naive_min"}
)


def _resolve_thresholds(config: Mapping[str, Any]) -> dict[str, float]:
    """Merge the documented thresholds with an optional runtime override.

    Args:
        config: Root configuration mapping.

    Returns:
        The thresholds to apply.
    """
    thresholds = dict(DEFAULT_THRESHOLDS)
    override = (config.get("metrics") or {}).get("thresholds") or {}
    for key, value in dict(override).items():
        if key not in thresholds:
            continue
        resolved = float(value)
        if key in PERCENT_FRACTION_KEYS and 0.0 < resolved <= 1.0:
            # 0.85 déclaré là où l'unité attendue est le pourcentage : on
            #convertit et on le dit,
            # plutôt que de comparer 86.56 à 0.85 et de publier un verdict décoratif.
            logger.warning(
                "Seuil '{}' déclaré en fraction ({}): conversion en pourcentage ({})",
                key,
                resolved,
                resolved * 100.0,
            )
            resolved *= 100.0
        thresholds[key] = resolved
    return thresholds


def _model_identity(model: Any, extras: Mapping[str, Any]) -> dict[str, str]:
    """Return the model identity as strings, tolerant to a missing model.

    Args:
        model: Optional model object.
        extras: Evaluation extras (which carry the model summary).

    Returns:
        Mapping with ``name``, ``algorithm`` and ``params``.
    """
    summary = str(extras.get("model") or "")
    if model is not None:
        name = summary or str(getattr(model, "name", "") or type(model).__name__)
        algorithm = str(getattr(model, "algorithm", None) or "n/a")
        params = str(getattr(model, "params", None) or "n/a")
    else:
        name, algorithm, params = summary or "n/a", "n/a", "n/a"
    return {"name": name, "algorithm": algorithm, "params": params}


def _period_of(result: EvaluationResult) -> str:
    """Return the chronological period covered by the evaluated rows.

    Args:
        result: Evaluation result.

    Returns:
        A human readable period, or ``non renseignée``.
    """
    frame = result.predictions
    for column in ("origin_date", "target_date"):
        if isinstance(frame, pd.DataFrame) and column in frame.columns:
            stamps = pd.to_datetime(frame[column])
            return f"{stamps.min().date()} → {stamps.max().date()}"
    return "non renseignée"


def _config_snapshot(paths: ProjectPaths) -> str:
    """Return the relative path of the resolved-configuration artefact.

    Args:
        paths: Project layout.

    Returns:
        A display path.
    """
    snapshot = Path(paths.models_dir) / "resolved_config.json"
    return snapshot.as_posix() if snapshot.exists() else "absente (relancer `mode=train`)"


def _naive_row(table: pd.DataFrame) -> dict[str, Any] | None:
    """Return the seasonal-naive row of the baseline table.

    Args:
        table: Baseline comparison table.

    Returns:
        The row as a mapping, or ``None``.
    """
    match = table[table["reference"].astype(str).str.contains("seasonal", case=False, na=False)]
    if match.empty:
        match = table[table["reference"] != "modèle appris"]
    return match.iloc[0].to_dict() if not match.empty else None


def _model_row(table: pd.DataFrame) -> dict[str, Any] | None:
    """Return the learned-model row of the baseline table.

    Args:
        table: Baseline comparison table.

    Returns:
        The row as a mapping, or ``None``.
    """
    match = table[table["reference"] == "modèle appris"]
    return match.iloc[0].to_dict() if not match.empty else None


def _relative_gain(naive: Mapping[str, Any], model: Mapping[str, Any]) -> float:
    """Relative MAPE reduction of the model against a reference, in percent.

    Args:
        naive: Reference row.
        model: Model row.

    Returns:
        The percentage of error removed.
    """
    reference = _float(naive.get("mape_pct"))
    current = _float(model.get("mape_pct"))
    if not np.isfinite(reference) or abs(reference) < 1e-9:
        return float("nan")
    return 100.0 * (reference - current) / reference


def _horizon_mape_of(table: pd.DataFrame, horizon: Any) -> float:
    """Return the MAPE of one horizon row.

    Args:
        table: Per-horizon table.
        horizon: Horizon value.

    Returns:
        The MAPE in percent.
    """
    match = table[table["horizon"] == horizon]
    return _float(match["mape_pct"].iloc[0]) if not match.empty else float("nan")


def _worst_horizon(table: pd.DataFrame) -> dict[str, Any] | None:
    """Return the horizon row with the highest MAPE.

    Args:
        table: Per-horizon table.

    Returns:
        The worst row as a mapping, or ``None``.
    """
    if table.empty or "mape_pct" not in table.columns:
        return None
    return table.sort_values("mape_pct", ascending=False).iloc[0].to_dict()


def _fold_trend(folds: pd.DataFrame) -> float | None:
    """Return the MAPE difference between the last and the first backtest fold.

    Args:
        folds: Backtest table without the dispersion row.

    Returns:
        The difference in percentage points, or ``None`` when fewer than two folds exist.
    """
    if folds.empty or len(folds) < 2 or "mape_pct" not in folds.columns:
        return None
    values = folds["mape_pct"].astype(float).to_numpy()
    return float(values[-1] - values[0])


def _family_of(feature: str) -> str:
    """Classify a feature into a readable family, for the importance table.

    Args:
        feature: Feature name.

    Returns:
        The family label (météo, calendrier, historique, niveau, horizon, autre).
    """
    name = feature.lower()
    if any(token in name for token in ("temperature", "hdd", "cdd", "cold", "heat")):
        return "météo"
    if any(token in name for token in ("weekday", "weekend", "holiday", "doy", "month", "quarter", "year", "school")):
        return "calendrier"
    if "rolling" in name or "momentum" in name or "level" in name:
        return "niveau récent"
    if "lag" in name or "last_observed" in name or "seasonal_naive" in name or "gap" in name:
        return "historique"
    if "horizon" in name:
        return "horizon"
    return "autre"


def _interval_label(method: str) -> str:
    """Return the business-readable name of an interval construction method.

    Args:
        method: Method identifier persisted by the evaluator.

    Returns:
        A French label usable in the report body.
    """
    labels = {
        "normalized_conformal": "prédiction conforme normalisée par horizon",
        "conformal": "prédiction conforme par horizon",
        "residual_quantile": "quantiles de résidus de validation",
    }
    return labels.get(method, method or "quantiles de résidus de validation")


def _bias_direction(extras: Mapping[str, Any]) -> str:
    """Return the direction of the mean bias, as a business-readable word.

    A negative bias is a systematic under-forecast, a positive one an over-forecast. Naming the
    direction matters more than its sign: the buyer reads « sous-prévision » and knows the
    consequence (buying balancing energy at spot price), while a minus sign needs interpreting.

    Args:
        extras: Evaluation extras carrying ``bias_pct``.

    Returns:
        ``sous-prévision`` or ``sur-prévision``.
    """
    return "sous-prévision" if _float(extras.get("bias_pct")) < 0 else "sur-prévision"


def _float(value: Any) -> float:
    """Coerce a value to float, mapping anything unusable to NaN.

    Args:
        value: Value to coerce.

    Returns:
        The float value.
    """
    try:
        result = float(value)
    except (TypeError, ValueError):
        return float("nan")
    return result


def _int(value: Any) -> int:
    """Coerce a value to int without raising.

    Args:
        value: Value to coerce.

    Returns:
        The integer value (0 when unusable).
    """
    try:
        return int(float(value))
    except (TypeError, ValueError):
        return 0


def _fmt(value: Any, digits: int = 3) -> str:
    """Format a number for a Markdown table, keeping NaN readable.

    Args:
        value: Value to format.
        digits: Number of decimals.

    Returns:
        The formatted string.
    """
    number = _float(value)
    if not np.isfinite(number):
        return "n/a"
    return f"{number:,.{digits}f}".replace(",", " ")
