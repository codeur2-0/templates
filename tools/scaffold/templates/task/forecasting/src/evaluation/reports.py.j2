            lines.append(f"### {titles.get(name, name)}")
            lines.append("")
            lines.append(f"![{name}]({relative.as_posix()})")
            lines.append("")
        return lines

    def _reproducibility_block(self, result: EvaluationResult, model: Any) -> list[str]:
        """Render the reproducibility footer."""
        extras = dict(result.extras or {})
        summary = _model_identity(model, extras)
        generated = datetime.now(tz=timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
        lines = [
