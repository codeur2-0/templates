DEFAULT_BUDGET_RATE = 0.02

#: Taille de l'échantillon de référence utilisé pour calibrer le seuil et les raisons.
REFERENCE_SAMPLES = 2000

#: Nombre de facteurs contributifs cités par transaction.
N_REASONS = 3

#: Écart-type standardisé au-delà duquel une feature est citée comme facteur contributif.
REASON_Z_THRESHOLD = 1.2

#: Niveaux de risque, définis par l'écart au seuil d'alerte exprimé en écarts-type de la
#: population de référence (du plus risqué au moins risqué). Les définir **relativement au seuil**
#: plutôt qu'en percentile du lot garantit deux propriétés : la décision est stable d'un lot à
#: l'autre (un lot de 5 transactions ne produit pas artificiellement un cas « critique ») et le
#: niveau de risque est cohérent avec `flagged`.
RISK_LEVELS: tuple[tuple[float, str], ...] = (
    (0.5, "critique"),
    (0.0, "élevé"),
    (-1.0, "modéré"),
    (-np.inf, "faible"),
)

